# VLM for labelling change regions (PydanticAI). Gemini Flash-Lite is the cheapest option that works well on crops.
GEMINI_API_KEY=
SPATIALITY_VLM_MODEL=gemini-2.5-flash-lite
# Hugging Face token: VGGT-Omega weights are gated (non-commercial research licence, automated approval).
HF_TOKEN=
# Modal: `modal token new` writes ~/.modal.toml; nothing needed here.
